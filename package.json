{
  "name": "react-flatifycss",
  "version": "2.2.0",
  "author": "Amir M. Mohamadi",
  "description": "A collection of flat design components for React, based on FlatifyCSS",
  "keywords": [
    "react",
    "components",
    "flatifycss",
    "flat-design",
    "design-system",
    "duolingo",
    "styled-components",
    "typescript",
    "rtl",
    "accessibility"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ami-momo/react-flatifycss.git"
  },
  "homepage": "https://react-flatifycss.amimomo.me",
  "bugs": {
    "url": "https://github.com/ami-momo/react-flatifycss/issues"
  },
  "license": "MIT",
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "!src/**/*.test.tsx",
    "!src/setupTests.ts",
    "!dist/**/*.test.d.ts",
    "!dist/setupTests.d.ts"
  ],
  "engines": {
    "node": ">=10"
  },
  "scripts": {
    "start": "tsdx watch",
    "build": "tsdx build",
    "test": "tsdx test --passWithNoTests",
    "lint": "tsdx lint",
    "typecheck": "tsc --noEmit -p .",
    "prepare": "tsdx build",
    "size": "size-limit",
    "analyze": "size-limit --why",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build:site": "bun run --cwd website build && storybook build -o website/dist/playground"
  },
  "prettier": {
    "printWidth": 80,
    "semi": true,
    "endOfLine": "auto",
    "singleQuote": true,
    "trailingComma": "es5"
  },
  "module": "dist/react-flatifycss.esm.js",
  "size-limit": [
    {
      "path": "dist/react-flatifycss.cjs.production.min.js",
      "limit": "250 KB"
    },
    {
      "path": "dist/react-flatifycss.esm.js",
      "limit": "250 KB"
    }
  ],
  "devDependencies": {
    "@babel/core": "^7.19.1",
    "@size-limit/preset-small-lib": "^8.1.0",
    "@storybook/addon-docs": "^10.6.8",
    "@storybook/addon-links": "^10.6.8",
    "@storybook/react-vite": "^10.6.8",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^13.4.0",
    "@types/react": "^18.0.21",
    "@types/react-dom": "^18.0.6",
    "@types/react-transition-group": "^4.4.5",
    "@types/styled-components": "^5.1.26",
    "babel-jest": "^25.5.1",
    "babel-plugin-styled-components": "^2.0.7",
    "flatifycss": "^2.0.0",
    "husky": "^8.0.1",
    "identity-obj-proxy": "^3.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-is": "^18.2.0",
    "remark-gfm": "4",
    "size-limit": "^8.1.0",
    "storybook": "^10.6.8",
    "tsdx": "^0.14.1",
    "tslib": "^2.4.0",
    "typescript": "^4.9.5",
    "vite": "^7.0.0"
  },
  "dependencies": {
    "@popperjs/core": "^2.11.6",
    "@reach/accordion": "^0.17.0",
    "@reach/dialog": "^0.17.0",
    "@reach/tabs": "^0.17.0",
    "clsx": "^1.2.1",
    "react-popper": "^2.3.0",
    "react-transition-group": "^4.4.5",
    "styled-components": "^5.3.5",
    "uuid-by-string": "^4.0.0"
  },
  "packageManager": "bun@1.4.5",
  "peerDependencies": {
    "react": "^16.8.0 || ^17.0.0 || ^18.0.0",
    "react-dom": "^16.8.0 || ^17.0.0 || ^18.0.0"
  },
  "overrides": {
    "lodash": "^4.18.0",
    "@babel/runtime": "^7.26.10",
    "@babel/traverse": "^7.23.2"
  }
}
